{
  "name": "@emiketic/lib-mantine",
  "version": "1.0.1",
  "description": "A collection of handy components built on Mantine components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "chroma-js": "^2.4.2",
    "@mantine/tiptap": "^9.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-subscript": "^3.0.0",
    "@tiptap/extension-superscript": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "countries-list": "^3.0.0",
    "libphonenumber-js": "^1.11.0"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@tabler/icons-react": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.0.0",
    "@types/chroma-js": "^2.4.4",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tabler/icons-react": "^3.40.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mantine",
    "react",
    "ui",
    "components",
    "emiketic"
  ],
  "license": "MIT",
  "author": {
    "name": "EMIKETIC Technologies",
    "email": "contact@emiketic.com",
    "url": "https://www.emiketic.com"
  }
}
